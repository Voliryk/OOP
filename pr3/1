#include <iostream>

int main() {
    int count = 0;
    int x;

    std::cout << "Введіть кількість: ";
    int a;
    std::cin >> a;

    std::cout << "Введіть числа:\n";
    for (int i = 0; i < a; i++) {
        std::cin >> x;
        if (x > 0 && x % 9 == 0) {
            count++;
        }
    }

    std::cout << "Кількість натуральних чисел: " << count << std::endl;
    return 0;
}
