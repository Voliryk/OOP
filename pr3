#include <iostream>
int main() {
    int count = 0; 
    int x;

    std::cout << "Введіть кількість: ";
    int N;
    std::cin >> N;

    std::cout << "Введіть числа:\n";
    for (int i = 0; i < N; i++) {
        std::cin >> x;
        if (x > 0 && x % 9 == 0) {
            count++;
        }
    }

    std::cout << "Кількість натуральних чисел: " << count << std::endl;
    return 0;
}
