#include <windows.h> 
#include <iostream>

int main() {
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
    int n;
    std::cout << "Введіть розмір масиву: ";
    std::cin >> n;

    double arr[100];
    std::cout << "Введіть елементи масиву:\n";
    for (int i = 0; i < n; i++) {
        std::cin >> arr[i];
    }
    
    double min_el = arr[0];
    for (int i = 1; i < n; i++) {
        if (arr[i] < min_el) {
            min_el = arr[i];
        }
    }

    double last_el = arr[n - 1];
    double sum = min_el + last_el;

    std::cout << "Мінімальний елемент: " << min_el << "\n";
    std::cout << "Останній елемент: " << last_el << "\n";
    std::cout << "Сума: " << sum << "\n";

    return 0;
}
