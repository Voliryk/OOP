        return name;
    }


    int reptWeight() {
        return weight;
    }


    void reptWeight(scale which) {
        if (which == kilograms) {
            std::cout << weight * 0.4536 << " кг";
        } else {
            std::cout << weight * 16 << " унцій";
        }
    }

    // повертає дату зважування
    int reptWeightDate() {
        return weightDate;
    }

    // кількість днів від останнього зважування
    int daysSinceLastWeighed(int today) {
        return today - weightDate;
    }
};

